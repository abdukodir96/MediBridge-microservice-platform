# Copy to .env and fill in before running `docker compose up`.
# Shared secret used by the JWT-issuing service (core) and the JWT-verifying
# service (chat) inside docker-compose. Must match between the two.
JWT_SECRET=change-me-before-deploying

# Optional. Powers chat message translation (apps/ai). Get a free key at
# https://aistudio.google.com/apikey. Leave blank and everything else still
# works — translation is best-effort and fails open (messages just won't
# have a translatedText).
GEMINI_API_KEY=
